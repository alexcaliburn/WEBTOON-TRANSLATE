<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#100d19">
  <title>WEBTOON TRANSLATOR</title>

  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #100d19;
      color: white;
    }

    header {
      text-align: center;
      padding: 30px 15px;
      background: #1c1630;
      border-bottom: 2px solid #a855f7;
    }

    h1 { color: #c084fc; font-size: 27px; }
    header p { color: #c4b5d8; }

    main {
      max-width: 650px;
      margin: 30px auto;
      padding: 15px;
    }

    .panel {
      background: #1c1630;
      padding: 22px;
      border: 1px solid #49346b;
      border-radius: 15px;
    }

    h2 { color: #c084fc; }

    .upload {
      padding: 20px;
      margin: 20px 0;
      border: 2px dashed #9333ea;
      border-radius: 12px;
      text-align: center;
    }

    input {
      width: 100%;
      margin-top: 15px;
      color: white;
    }

    #preview {
      display: none;
      width: 100%;
      margin-top: 20px;
      border-radius: 10px;
    }

    button {
      width: 100%;
      padding: 15px;
      margin-top: 12px;
      border: none;
      border-radius: 10px;
      background: #9333ea;
      color: white;
      font-size: 16px;
      font-weight: bold;
    }

    button:disabled {
      opacity: 0.45;
    }

    #message {
      margin-top: 20px;
      color: #c084fc;
      text-align: center;
      overflow-wrap: anywhere;
    }

    .result {
      display: none;
      margin-top: 25px;
      padding: 15px;
      background: #100d19;
      border-radius: 10px;
      border: 1px solid #49346b;
    }

    .result p {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      line-height: 1.7;
    }

    .note {
      color: #a99bbd;
      font-size: 13px;
      text-align: center;
      margin-top: 20px;
    }
  </style>
</head>

<body>

<header>
  <h1>WEBTOON TRANSLATOR</h1>
  <p>Lis tes webtoons dans ta langue</p>
</header>

<main>
  <div class="panel">

    <h2>Traduire un webtoon</h2>
    <p>Importe une image contenant du texte coréen.</p>

    <div class="upload">
      <label for="imageInput">Choisir une image</label>
      <input type="file" id="imageInput" accept="image/*">
    </div>

    <img id="preview" alt="Aperçu du webtoon">

    <button id="analyzeButton" disabled>
      Analyser le texte coréen
    </button>

    <button id="translateButton" disabled>
      Traduire en français
    </button>

    <p id="message">En attente d'une image.</p>

    <div class="result" id="originalBox">
      <h2>Texte coréen détecté</h2>
      <p id="originalText"></p>
    </div>

    <div class="result" id="translationBox">
      <h2>Traduction française</h2>
      <p id="translatedText"></p>
    </div>

    <p class="note">
      Version de test : reconnaissance et traduction du texte.
      Le remplacement du texte dans les bulles viendra ensuite.
    </p>

  </div>
</main>

<script>
  const imageInput = document.getElementById("imageInput");
  const preview = document.getElementById("preview");
  const message = document.getElementById("message");

  const analyzeButton = document.getElementById("analyzeButton");
  const translateButton = document.getElementById("translateButton");

  const originalBox = document.getElementById("originalBox");
  const translationBox = document.getElementById("translationBox");

  const originalText = document.getElementById("originalText");
  const translatedText = document.getElementById("translatedText");

  let selectedImage = null;
  let detectedKorean = "";

  imageInput.addEventListener("change", function() {
    const file = this.files[0];

    detectedKorean = "";
    originalText.textContent = "";
    translatedText.textContent = "";

    originalBox.style.display = "none";
    translationBox.style.display = "none";

    translateButton.disabled = true;

    if (!file) {
      selectedImage = null;
      preview.style.display = "none";
      analyzeButton.disabled = true;
      message.textContent = "Aucune image sélectionnée.";
      return;
    }

    if (!file.type.startsWith("image/")) {
      selectedImage = null;
      analyzeButton.disabled = true;
      message.textContent = "Choisis une image valide.";
      return;
    }

    selectedImage = file;
    preview.src = URL.createObjectURL(file);
    preview.style.display = "block";

    analyzeButton.disabled = false;
    message.textContent = "Image importée avec succès !";
  });

  analyzeButton.addEventListener("click", analyzeImage);
  translateButton.addEventListener("click", translateImage);

  async function analyzeImage() {
    if (!selectedImage) return;

    if (typeof Tesseract === "undefined") {
      message.textContent = "Le moteur OCR n'a pas pu être chargé.";
      return;
    }

    analyzeButton.disabled = true;
    translateButton.disabled = true;
    originalBox.style.display = "none";
    translationBox.style.display = "none";

    let worker = null;

    try {
      message.textContent = "Préparation de la reconnaissance...";

      worker = await Tesseract.createWorker(
        "kor",
        1,
        {
          logger: function(info) {
            if (info.status === "loading language traineddata") {
              message.textContent = "Chargement du modèle coréen...";
            }

            if (info.status === "recognizing text") {
              message.textContent =
                "Analyse : " + Math.round(info.progress * 100) + "%";
            }
          }
        }
      );

      const result = await worker.recognize(selectedImage);
      detectedKorean = result.data.text.trim();

      if (detectedKorean) {
        originalText.textContent = detectedKorean;
        originalBox.style.display = "block";
        translateButton.disabled = false;
        message.textContent = "Texte coréen reconnu !";
      } else {
        message.textContent = "Aucun texte détecté.";
      }

    } catch (error) {
      console.error(error);
      message.textContent = "Erreur OCR : " + error.message;

    } finally {
      if (worker) {
        await worker.terminate();
      }

      analyzeButton.disabled = false;
    }
  }

  function splitIntoChunks(text, maxBytes = 400) {
    const chunks = [];
    let current = "";
    let currentBytes = 0;

    for (const character of text) {
      const bytes = new TextEncoder().encode(character).length;

      if (currentBytes + bytes > maxBytes && current) {
        chunks.push(current);
        current = "";
        currentBytes = 0;
      }

      current += character;
      currentBytes += bytes;
    }

    if (current) chunks.push(current);

    return chunks;
  }

  async function translateImage() {
    if (!detectedKorean) {
      message.textContent = "Analyse d'abord une image.";
      return;
    }

    translateButton.disabled = true;
    translationBox.style.display = "none";

    try {
      const chunks = splitIntoChunks(detectedKorean);
      const translations = [];

      for (let i = 0; i < chunks.length; i++) {
        message.textContent =
          "Traduction en cours : " + (i + 1) + "/" + chunks.length;

        const params = new URLSearchParams({
          q: chunks[i],
          langpair: "ko|fr"
        });

        const response = await fetch(
          "https://api.mymemory.translated.net/get?" + params.toString()
        );

        if (!response.ok) {
          throw new Error("Le service de traduction ne répond pas.");
        }

        const data = await response.json();

        if (!data.responseData ||
            !data.responseData.translatedText) {
          throw new Error("Aucune traduction reçue.");
        }

        translations.push(data.responseData.translatedText);
      }

      translatedText.textContent = translations.join(" ");
      translationBox.style.display = "block";
      message.textContent = "Traduction terminée !";

    } catch (error) {
      console.error(error);
      message.textContent =
        "Erreur de traduction : " + error.message;

    } finally {
      translateButton.disabled = false;
    }
  }
</script>
</body>
</html>
